# ── Application ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

#Groq
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b


# Anthropic
ANTHROPIC_API_KEY=dummy

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=talent_hub
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/talent_hub

# Redis
REDIS_URL=redis://localhost:6379

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your_email_id@gmail.com
SMTP_PASSWORD=your_password

# ── LangSmith tracing (see docs/architecture/tracing.md) ─────
# Off by default. In development turn it on only with synthetic or your own data.
# Keep real keys in your private .env, never in this file.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_key
# One project per environment: talent-hub-development, talent-hub-staging (CI, reserved), talent-hub-production
LANGCHAIN_PROJECT=talent-hub-development
# Share of traces kept, 0 to 1 (production starts at 0.1). A bad value drops all traces.
# LANGSMITH_TRACING_SAMPLING_RATE=1.0
# Production only: hide inputs and outputs so traces never hold user content.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
# Secret that turns user ids into the hashes shown in traces. Use a long random
# value, different for each environment.
# TRACE_HASH_SECRET=change_me

# ── MCP (external tool servers) ──────────────────────────────
# The server list lives in app/mcp/mcp_servers.yaml. Every server there stays
# disabled until it has been vetted, so nothing needs to be set for a default run.
# Optional: load the registry from a different file.
# MCP_REGISTRY_PATH=
# Optional: URL of the local demo server. docker-compose already sets this for the
# backend container; set it only to run the backend outside Docker against a demo
# server on your machine.
# MCP_DEMO_URL=http://localhost:8100/mcp
# Keys for MCP servers: the YAML names the variable, the value goes here, never in
# the YAML. Example:
# ONET_API_KEY=

# ── Vector Store — ChromaDB (local, free) ────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_db
ANONYMIZED_TELEMETRY=False

# ── File Storage (local, free) ───────────────────────────────
UPLOAD_DIR=./data/uploads

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

